# Normalize line endings to LF across Windows/Linux to stop CRLF churn
# (this repo moves between a Windows machine and a Linux laptop)
* text=auto eol=lf

# Windows batch scripts must stay CRLF
*.bat text eol=crlf

# Binary assets — never diff or normalize
*.docx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.jar  binary
*.keystore binary
*.ttf  binary
*.otf  binary
