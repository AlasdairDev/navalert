<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch window (cold boot), drawn by Android until Flutter renders
     its first frame. This was @android:color/white, which flashed white before
     the deep-purple UI appeared — most jarring in exactly the setting this app
     is built for, a dark night commute. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/navalert_background" />
</layer-list>
