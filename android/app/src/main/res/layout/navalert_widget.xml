<?xml version="1.0" encoding="utf-8"?>
<!--
  NavAlert home-screen widget (Batch 3) — THIS is the widget's visual surface.
  Match the in-app theme (NavAlertColors) where you can; RemoteViews can't
  read Flutter's theme so the hex values are duplicated here on purpose.

  DO NOT MODIFY LOGIC: the android:id values below are referenced by name in
  NavAlertWidgetProvider.kt (setTextViewText / setOnClickPendingIntent).
  Renaming or removing an id — or the widget_root / widget_sos tap targets —
  breaks the live updates and the one-tap SOS. Restyle the views, keep the ids.

  RemoteViews is limited (basic views + text/image only), so this is a clean
  functional layout, not a pixel-match of the in-app screens.
    @+id/widget_root         tap → opens the app (navalert://open)
    @+id/widget_status       "Monitoring" / "No active trip"
    @+id/widget_destination  destination name
    @+id/widget_distance     "1.2 km away"
    @+id/widget_eta          "ETA 8 min"
    @+id/widget_sos          tap → one-tap SOS (navalert://sos)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NavAlert"
            android:textColor="#B39DDB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No active trip"
            android:textColor="#66BB6A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_destination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Tap to plan your commute"
        android:textColor="#F4F0FA"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#BFB3D9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#BFB3D9"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_sos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_sos_bg"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="SOS — send my location"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
