<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window, drawn while the process starts.
         The parent is a DARK theme even though this is the system's LIGHT-mode
         resource folder. NavAlert has a single look — the deep-purple night
         commute — so following the system into a light launch window flashed
         white before the app appeared. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started, and drawn BEHIND the Flutter UI
         for the rest of the session. Pinned to the app colour for the same
         reason: anything the Flutter surface does not cover for a frame
         (rotation, resize, the moment before first paint) shows this, and
         ?android:colorBackground resolves to white in light mode. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/navalert_background</item>
    </style>
</resources>
